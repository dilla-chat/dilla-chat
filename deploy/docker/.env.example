# Dilla — Compose .env example. Copy to `.env`, fill in real values.
# Refer to server-rs/src/config.rs for the full env-var surface.

# --- Public hostname (must match the cert + Caddyfile) ----------------------
DILLA_DOMAIN=chat.example.com
ADMIN_EMAIL=ops@example.com

# --- Identity ----------------------------------------------------------------
DILLA_TEAM=
DILLA_NODE_NAME=node-a

# --- Server behaviour --------------------------------------------------------
DILLA_LOG_LEVEL=info
DILLA_LOG_FORMAT=json
DILLA_ALLOWED_ORIGINS=https://chat.example.com
DILLA_MAX_UPLOAD_SIZE=26214400          # 25 MiB
DILLA_UPLOAD_QUOTA_PER_TEAM_GB=10
DILLA_RATELIMIT_PER_SECOND=30
DILLA_RATELIMIT_BURST=60

# --- TURN (Cloudflare). Generate token per deploy/turn/README.md -----------
DILLA_TURN_MODE=cloudflare
DILLA_CF_TURN_KEY_ID=
DILLA_CF_TURN_API_TOKEN=                 # prefer DILLA_CF_TURN_API_TOKEN_FILE — pending
DILLA_TURN_TTL=3600

# --- Telemetry (OTLP -> local collector) -----------------------------------
DILLA_OTEL_ENABLED=false
DILLA_OTEL_PROTOCOL=http
DILLA_OTEL_HTTP_ENDPOINT=http://otel-collector:4318
DILLA_ENVIRONMENT=production

# --- Federation (filled in only on federated installs) ---------------------
# Prefer the compose.federation.yml overlay over hard-coding here.
# DILLA_PEERS=
# DILLA_FED_BIND_ADDR=10.42.0.1
# DILLA_FEDERATION_PORT=9443
# DILLA_FED_ADVERTISE_ADDR=10.42.0.1
# DILLA_FED_ADVERTISE_PORT=9443
